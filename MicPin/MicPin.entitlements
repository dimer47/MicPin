<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Droits requis par le runtime durci, lui-même exigé par la notarisation.

	  Sans eux, l'application est signée et notarisée mais échoue à
	  l'exécution : la mise à jour ne peut ni vérifier une signature ni monter
	  le disque téléchargé, sans message d'erreur explicite.
	-->

	<!-- Accès au micro pour le maintien éveillé.

	     Sous runtime durci, TCC refuse l'accès sans cet entitlement et
	     n'affiche même aucune demande d'autorisation : le journal indique
	     « requires entitlement com.apple.security.device.audio-input but it
	     is missing ». La clé NSMicrophoneUsageDescription de l'Info.plist ne
	     suffit pas à elle seule. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- La mise à jour lance /usr/sbin/spctl, /usr/bin/hdiutil et /bin/bash,
	     qui appartiennent au système et ne sont pas signés par notre équipe. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Le bac à sable reste désactivé : lire et modifier les périphériques
	     audio du système y est impossible. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
